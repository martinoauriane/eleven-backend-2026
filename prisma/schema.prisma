generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum NotificationType {
  ON_ITS_WAY
  JOIN_REQUEST
  JOIN_ACCEPTED
  EVENT_UPDATED
}

enum MoodStatus {
  CHILLING
  WANTS_TO_GO_OUT
  BORED
  ABOUT_TO_LEAVE
}

enum JoinRequestStatus {
  NONE
  SENT
  ACCEPTED
  REJECTED
}

model User {
  id                     Int             @id @default(autoincrement())
  firstName              String
  lastName               String
  email                  String          @unique
  picture                String?         @unique
  password               String
  homeAddress            String?
  isOnline               Boolean         @default(false)
  lastLogin              DateTime        @default(now())
  mood                   MoodStatus?
  moodUpdatedAt          DateTime?
  eventsCreated          Event[]         @relation("EventCreator")
  sentFriendRequests     FriendRequest[] @relation("EmitterFriendRequest")
  receivedFriendRequests FriendRequest[] @relation("ReceiverFriendRequest")
  sentJoinRequests       JoinRequest[]   @relation("EmitterJoinRequest")
  receivedJoinRequests   JoinRequest[]   @relation("ReceiverJoinRequest")
  onMap                  OnMap?
  favorites              Event[]         @relation("UserFavorites")

  sentFriendships     Friendship[] @relation("FriendshipUser")
  receivedFriendships Friendship[] @relation("FriendshipFriend")
  attendingEvents Event[] @relation("EventParticipants")

  sentNotifications Notification[] @relation("NotificationSender")
  receivedNotifications Notification[] @relation("NotificationReceiver")
  
  conversations Conversation[] @relation("ConversationParticipants")
  messages      Message[]
}

model Friendship {
  id Int @id @default(autoincrement())

  userId   Int
  friendId Int

  user   User @relation("FriendshipUser", fields: [userId], references: [id])
  friend User @relation("FriendshipFriend", fields: [friendId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, friendId])
  @@index([friendId, userId])
}

model OnMap {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  latitude  Float
  longitude Float
  address   String?
  activity  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Event {
  id             Int      @id @default(autoincrement())
  eventName      String
  eventType      String
  eventLat       Float
  eventLon       Float
  eventAddress   String
  isFull         Boolean  @default(false)
  eventCity      String
  eventCountry   String
  isPublic       Boolean  @default(true)
  eventStartTime DateTime @default(now())
  eventEndTime   DateTime @default(now())
  userId         Int
  createdBy      User     @relation("EventCreator", fields: [userId], references: [id])
  favoritedBy    User[]   @relation("UserFavorites")
  joinRequests   JoinRequest[]
  participants   User[] @relation("EventParticipants")
  notifications Notification[]
}

model JoinRequest {
  id        Int      @id @default(autoincrement())
  sentAt    DateTime @default(now())

  status    JoinRequestStatus @default(SENT)

  emitterId Int
  receiverId Int

  eventId Int

  emitter  User  @relation("EmitterJoinRequest", fields: [emitterId], references: [id])
  receiver User  @relation("ReceiverJoinRequest", fields: [receiverId], references: [id])

  event     Event @relation(fields: [eventId], references: [id])

  message   Message?

  @@unique([emitterId, eventId])
}

model FriendRequest {
  id         Int      @id @default(autoincrement())
  sentAt     DateTime @default(now())
  isAccepted Boolean  @default(false)
  emitterId  Int
  receiverId Int
  emitter    User     @relation("EmitterFriendRequest", fields: [emitterId], references: [id])
  receiver   User     @relation("ReceiverFriendRequest", fields: [receiverId], references: [id])
}

model Conversation {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants User[] @relation("ConversationParticipants")

  messages Message[]
}

model Message {
  id             Int      @id @default(autoincrement())
  type           String
  content        Json
  createdAt      DateTime @default(now())

  isRead         Boolean  @default(false)
  readAt         DateTime?

  senderId       Int
  conversationId Int
  joinRequestId  Int? @unique

  sender         User         @relation(fields: [senderId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  joinRequest    JoinRequest? @relation(fields: [joinRequestId], references: [id])
}

model Notification {
  id          Int   @id @default(autoincrement())
  type        NotificationType

  message     String

  senderId    Int
  sender      User @relation("NotificationSender", fields: [senderId], references: [id])

  receiverId  Int
  receiver    User @relation("NotificationReceiver", fields: [receiverId], references: [id])

  eventId     Int?
  event       Event? @relation(fields: [eventId], references: [id])

  read        Boolean @default(false)

  createdAt   DateTime @default(now())
}
