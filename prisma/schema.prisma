generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum NotificationType {
  ON_ITS_WAY
  JOIN_REQUEST
  JOIN_ACCEPTED
  EVENT_UPDATED
}

enum MoodStatus {
  CHILLING
  WANTS_TO_GO_OUT
  BORED
  ABOUT_TO_LEAVE
}

enum MeetRequestStatus {
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum JoinRequestStatus {
  NONE
  SENT
  ACCEPTED
  REJECTED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ConversationMemberRole {
  ADMIN
  MEMBER
}

model User {
  id            Int      @id @default(autoincrement())
  firstName     String
  lastName      String
  email         String   @unique
  picture       String?  @unique
  password      String
  homeAddress   String?
  isOnline      Boolean  @default(false)
  lastLogin     DateTime @default(now())
  mood          MoodStatus?
  moodUpdatedAt DateTime?

  eventsCreated   Event[] @relation("EventCreator")
  attendingEvents Event[] @relation("EventParticipants")
  favorites       Event[] @relation("UserFavorites")

  sentFriendRequests     FriendRequest[] @relation("EmitterFriendRequest")
  receivedFriendRequests FriendRequest[] @relation("ReceiverFriendRequest")

  sentFriendships     Friendship[] @relation("FriendshipUser")
  receivedFriendships Friendship[] @relation("FriendshipFriend")

  sentJoinRequests     JoinRequest[] @relation("EmitterJoinRequest")
  receivedJoinRequests JoinRequest[] @relation("ReceiverJoinRequest")

  onMap OnMap?

  sentNotifications     Notification[] @relation("NotificationSender")
  receivedNotifications Notification[] @relation("NotificationReceiver")

  sentMeetRequests     MeetRequest[] @relation("EmitterMeetRequest")
  receivedMeetRequests MeetRequest[] @relation("ReceiverMeetRequest")

  createdConversations Conversation[]       @relation("ConversationCreator")
  conversationMembers  ConversationMember[]

  messages         Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageReceiver")

  uploadedEventPhotos EventPhoto[]

  stories Story[]
}

model Friendship {
  id        Int      @id @default(autoincrement())
  userId    Int
  friendId  Int
  createdAt DateTime @default(now())

  user   User @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([friendId, userId])
}

model OnMap {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  latitude  Float
  longitude Float
  address   String?
  activity  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id             Int      @id @default(autoincrement())
  eventName      String
  eventType      String
  eventLat       Float
  eventLon       Float
  eventAddress   String
  eventCity      String
  eventCountry   String
  isFull         Boolean  @default(false)
  isPublic       Boolean  @default(true)
  eventStartTime DateTime @default(now())
  eventEndTime   DateTime @default(now())

  HostId Int
  Host   User @relation("EventCreator", fields: [HostId], references: [id], onDelete: Cascade)

  favoritedBy  User[]         @relation("UserFavorites")
  joinRequests JoinRequest[]
  participants User[]         @relation("EventParticipants")
  notifications Notification[]
  photos       EventPhoto[]

  conversations Conversation[]

  @@index([HostId])
}

model JoinRequest {
  id         Int               @id @default(autoincrement())
  sentAt     DateTime          @default(now())
  status     JoinRequestStatus @default(SENT)
  senderId   Int
  receiverId Int
  eventId    Int

  sender   User  @relation("EmitterJoinRequest", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User  @relation("ReceiverJoinRequest", fields: [receiverId], references: [id], onDelete: Cascade)
  event    Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  message Message?

  @@unique([senderId, eventId])
  @@index([receiverId])
  @@index([eventId])
}

model MeetRequest {
  id         Int      @id @default(autoincrement())
  emitterId  Int
  receiverId Int
  latitude   Float
  longitude  Float
  address    String?
  activity   String?
  status     MeetRequestStatus @default(SENT)
  sentAt     DateTime @default(now())
  expiresAt  DateTime?

  emitter  User @relation("EmitterMeetRequest", fields: [emitterId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceiverMeetRequest", fields: [receiverId], references: [id], onDelete: Cascade)

  message Message?

  @@unique([emitterId, receiverId])
  @@index([receiverId])
}

model FriendRequest {
  id         Int      @id @default(autoincrement())
  sentAt     DateTime @default(now())
  isAccepted Boolean  @default(false)
  emitterId  Int
  receiverId Int

  emitter  User @relation("EmitterFriendRequest", fields: [emitterId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceiverFriendRequest", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([emitterId, receiverId])
  @@index([receiverId])
}

model Conversation {
  id      Int              @id @default(autoincrement())
  type    ConversationType @default(DIRECT)

  name    String?
  picture String?

  eventId Int?
  event   Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  createdBy Int?
  creator   User? @relation("ConversationCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationMember[]

  messages Message[]

  @@index([eventId])
  @@index([createdBy])
  @@index([type])
}

model ConversationMember {
  id             Int                    @id @default(autoincrement())
  conversationId Int
  userId         Int
  role           ConversationMemberRole @default(MEMBER)
  joinedAt       DateTime               @default(now())

  conversation Conversation @relation( fields: [conversationId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             Int      @id @default(autoincrement())
  type           String
  content        Json

  sentAt DateTime @default(now())

  isRead Boolean   @default(false)
  readAt DateTime?

  senderId Int
  sender   User @relation( "MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId Int?
  receiver   User? @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  joinRequestId Int? @unique
  joinRequest   JoinRequest? @relation(fields: [joinRequestId], references: [id], onDelete: Cascade)

  meetRequestId Int? @unique
  meetRequest   MeetRequest? @relation(fields: [meetRequestId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@index([senderId])
  @@index([receiverId])
}

model Notification {
  id         Int              @id @default(autoincrement())
  type       NotificationType
  message    String

  senderId   Int
  receiverId Int

  sender   User @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Cascade)

  receiver User @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  eventId Int?
  event   Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([receiverId, read])
}

model EventPhoto {
  id           Int      @id @default(autoincrement())
  url          String
  createdAt    DateTime @default(now())

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  uploadedById Int?
  uploadedBy   User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([eventId])
}

model Story {
  id        Int      @id @default(autoincrement())
  url       String
  createdAt DateTime @default(now())
  expiresAt DateTime

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
